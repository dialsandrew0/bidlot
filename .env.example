# bidlot — environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, NEVER expose to the browser
# Used by API routes to bypass RLS for trusted server operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────
# Secret token the Chrome extension must send in the
# X-Bidlot-Token header when calling /api/import/ctbids-watchlist
BIDLOT_IMPORT_SECRET=change-me-to-a-long-random-string

# ── Optional: Vercel / deployment ─────────────────────────────
# VERCEL_URL is injected automatically on Vercel; only needed locally
# NEXT_PUBLIC_APP_URL=http://localhost:3000
