{
  "manifest_version": 3,
  "name": "bidlot Collector",
  "version": "0.1.0",
  "description": "Import your CTBids watchlist into bidlot for instant max-bid scoring and triage.",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["https://ctbids.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send watchlist to bidlot",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
